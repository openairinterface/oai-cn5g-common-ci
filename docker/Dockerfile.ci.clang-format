#/*
# * SPDX-License-Identifier: MIT
# */
#---------------------------------------------------------------------
#
FROM ubuntu:jammy AS nfName-clang-format-check
# Empty for push builds (whole-repo check); the caller passes
# "--src-branch X --target-branch Y" for PR builds (diff-only check) --
# checkCodingFormattingRules.sh branches on argument count, not on
# whether the branch values are empty, so this must expand to zero
# words rather than pass empty strings.
ARG EXTRA_ARGS=""

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install --yes \
      git \
      tree \
      clang-format-12 && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-12 20 && \
    clang-format --version

WORKDIR /home
COPY . .

RUN /bin/bash -c "./ci-scripts/common/bash/checkCodingFormattingRules.sh $EXTRA_ARGS"
